---
// Sección "Resalta tu mirada": texto con botón de WhatsApp y foto grande con parallax.
// Contenido: centro.mirada.
import Foto from "./Foto.astro";
import { centro, enlaceWhatsApp } from "../data/centro";
const { mirada } = centro;
---
<section class="seccion overflow-clip bg-tinte">
  <div class="contenedor grid items-center gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
    <div class="revelar">
      <h2 class="titulo-seccion">{mirada.titulo}</h2>
      <p class="intro-seccion">{mirada.texto}</p>
      <a href={enlaceWhatsApp} class="boton-principal mt-8" target="_blank" rel="noopener">Pregunta por tu valoración</a>
    </div>
    <div class="revelar" style="--retraso:150ms">
      <Foto nombre={mirada.foto} alt={mirada.alt} etiqueta="Foto: resalta tu mirada" foco={mirada.foco} class="aspect-[4/3] rounded-[1.25rem] bg-vino!" sizes="(min-width: 768px) 55vw, 100vw" parallax />
    </div>
  </div>
</section>
