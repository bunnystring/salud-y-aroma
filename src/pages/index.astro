---
// Página única del sitio. El orden de los componentes es el orden de las secciones.
import Base from "../layouts/Base.astro";
import Encabezado from "../components/Encabezado.astro";
import Portada from "../components/Portada.astro";
import Servicios from "../components/Servicios.astro";
import Mirada from "../components/Mirada.astro";
import Trabajo from "../components/Trabajo.astro";
import Bienestar from "../components/Bienestar.astro";
import Nosotros from "../components/Nosotros.astro";
import Producto from "../components/Producto.astro";
import Testimonios from "../components/Testimonios.astro";
import Ubicacion from "../components/Ubicacion.astro";
import Llamado from "../components/Llamado.astro";
import Pie from "../components/Pie.astro";
import WhatsAppFlotante from "../components/WhatsAppFlotante.astro";
---
<Base>
  <Encabezado />
  <main>
    <Portada />
    <Servicios />
    <Mirada />
    <Trabajo />
    <Bienestar />
    <Nosotros />
    <Producto />
    <Testimonios />
    <Ubicacion />
    <Llamado />
  </main>
  <Pie />
  <WhatsAppFlotante />
</Base>
